rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Олон нийт зургийг унших
    match /{allPaths=**} {
      allow read: if true;
    }

    // Төслийн thumbnail — зөвхөн админ upload/устгах
    match /projects/{sector}/{slug}/{fileName} {
      allow write: if request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Ангилалын зураг — зөвхөн админ
    match /categories/{fileName} {
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
